{
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^24.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "cypress": "^15.14.2",
    "cypress-xpath": "^2.0.1",
    "esbuild": "^0.28.0",
    "multiple-cucumber-html-reporter": "^3.8.0",
    "rimraf": "^6.1.3"
  },
  "scripts": {
    "cy:run": "npx cypress run --env AMBIENTE=dev",
    "cy:run:qa": "npx cypress run --env AMBIENTE=qa",
    "cy:run:prod": "npx cypress run --env AMBIENTE=prod",

    "cy:run:login": "npx cypress run --spec 'cypress/e2e/login/login.feature' --env AMBIENTE=dev",
    "cy:run:login:qa": "npx cypress run --spec 'cypress/e2e/login/login.feature' --env AMBIENTE=qa",
    "cy:run:login:prod": "npx cypress run --spec 'cypress/e2e/login/login.feature' --env AMBIENTE=prod",

    "cy:run:inventory": "npx cypress run --spec 'cypress/e2e/inventory/inventary.feature' --env AMBIENTE=dev",
    "cy:run:inventory:qa": "npx cypress run --spec 'cypress/e2e/inventory/inventary.feature' --env AMBIENTE=qa",
    "cy:run:inventory:prod": "npx cypress run --spec 'cypress/e2e/inventory/inventary.feature' --env AMBIENTE=prod",

    "cy:report": "node cucumber-report.js",
    "cy:clean": "npx rimraf cypress/reports",

    "cy:full": "npm run cy:clean && npm run cy:run && npm run cy:report",
    "cy:full:qa": "npm run cy:clean && npm run cy:run:qa && npm run cy:report",
    "cy:full:prod": "npm run cy:clean && npm run cy:run:prod && npm run cy:report",

    "cy:full:login": "npm run cy:clean && npm run cy:run:login && npm run cy:report",
    "cy:full:inventory": "npm run cy:clean && npm run cy:run:inventory && npm run cy:report"
  },
  "cypress-cucumber-preprocessor": {
    "nonGlobalStepDefinitions": false,
    "stepDefinitions": "cypress/step_definitions/**/*.{js,ts}",
    "json": {
      "enabled": true,
      "output": "cypress/reports/cucumber-json/results.json"
    }
  }
}